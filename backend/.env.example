# MMPI-2 Assessment Platform - Environment Configuration
# Copy this file to .env and update the values

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Environment: development or production
ENVIRONMENT=development

# Database connection string
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./mmpi.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mmpi_db

# JWT Secret Key (REQUIRED in production - must be at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# JWT Token expiration in hours (default: 24)
JWT_EXPIRE_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════════
# CORS CONFIGURATION (Production)
# ═══════════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MMPI Platform
SMTP_USE_TLS=true

# ═══════════════════════════════════════════════════════════════════════════════
# AI FEATURES (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# OpenAI API Key for AI-powered features
OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE INTEGRATION (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Google OAuth for Calendar + Google Meet integration (Settings > Integrations).
# Create these in Google Cloud Console > APIs & Services > Credentials
# (OAuth client type: "Web application"). Enable the Google Calendar API on the
# project first. Register this exact redirect URI on the OAuth client — the
# frontend sends "<your frontend origin>/settings/google-callback"
# (e.g. http://localhost:5173/settings/google-callback in dev):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# WHATSAPP INTEGRATION (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════════

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
